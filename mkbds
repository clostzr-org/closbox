#!/usr/bin/env python3
"""Save Termux multiling keyboard settings from the clipboard."""

import sys
from pathlib import Path

from tcget import tcget


def main():
    try:
        content = tcget().strip()
    except Exception as error:
        print(f"Unable to read clipboard: {error}", file=sys.stderr)
        return 1

    if not content:
        print("Clipboard is empty.", file=sys.stderr)
        return 1
    if content.split(maxsplit=1)[0] != "OK_Settings_Begin":
        print("Usage: copy the multiling keyboard settings, then run this script.")
        return 1

    output = Path(__file__).resolve().with_suffix(".txt")
    try:
        output.write_text(content, encoding="utf-8")
    except OSError as error:
        print(f"Unable to save settings to {output}: {error}", file=sys.stderr)
        return 1

    print(f"Settings saved to: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
