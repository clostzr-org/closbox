#!/usr/bin/env python3
"""Optimize JPEG images and convert PNG images to JPEG."""

import importlib.util
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


EXTENSIONS = {".jpg", ".jpeg", ".png"}


def pillow_image():
    if importlib.util.find_spec("PIL") is None:
        print("Installing missing dependency: Pillow")
        try:
            subprocess.run(
                [sys.executable, "-m", "pip", "install", "Pillow"], check=True
            )
        except (OSError, subprocess.CalledProcessError) as error:
            raise RuntimeError(f"Could not install Pillow; install it manually. {error}") from error
        importlib.invalidate_caches()
    from PIL import Image, ImageOps
    return Image, ImageOps


def optimize(source, image_module, image_ops):
    source = Path(source)
    target = source.with_suffix(".jpeg") if source.suffix.lower() == ".png" else source
    if target != source and target.exists():
        return f"Skipped {source}: destination exists ({target.name})"

    temporary = None
    try:
        with image_module.open(source) as image:
            image = image_ops.exif_transpose(image)
            if image.mode in ("RGBA", "LA") or "transparency" in image.info:
                rgba = image.convert("RGBA")
                background = image_module.new("RGB", rgba.size, "white")
                background.paste(rgba, mask=rgba.getchannel("A"))
                image = background
            else:
                image = image.convert("RGB")

            with tempfile.NamedTemporaryFile(
                dir=source.parent, suffix=".jpg", delete=False
            ) as file:
                temporary = Path(file.name)
            image.save(temporary, format="JPEG", quality=95, optimize=True)

        before = source.stat().st_size
        if target == source:
            os.replace(temporary, target)
            temporary = None
        else:
            os.replace(temporary, target)
            temporary = None
            source.unlink()

        after = target.stat().st_size
        saved = before - after
        percent = saved / before * 100 if before else 0
        return (
            f"{source.name} -> {target.name}: "
            f"{before:,} -> {after:,} bytes ({percent:+.1f}%)"
        )
    except (OSError, ValueError) as error:
        return f"Failed to optimize {source}: {error}"
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def main():
    if len(sys.argv) > 2:
        print(f"Usage: {Path(sys.argv[0]).name} [image-file-or-directory]", file=sys.stderr)
        return 2

    target = sys.argv[1] if len(sys.argv) == 2 else ""
    if not target:
        clipboard = shutil.which("termux-clipboard-get")
        if clipboard:
            try:
                target = subprocess.run(
                    [clipboard], check=True, capture_output=True, text=True
                ).stdout.strip()
            except (OSError, subprocess.SubprocessError) as error:
                print(f"Clipboard unavailable: {error}", file=sys.stderr)
        if not target:
            target = input("Image file or directory: ").strip()
        if not target:
            print("An image file or directory is required.", file=sys.stderr)
            return 2

        path = Path(target).expanduser()
    if not path.exists():
        print(f"Path does not exist: {path}", file=sys.stderr)
        return 1
    files = (
        [path]
        if path.is_file()
        else sorted(
            (
                item
                for item in path.rglob("*")
                if item.is_file() and item.suffix.lower() in EXTENSIONS
            ),
            key=lambda item: str(item).casefold(),
        )
    )
    files = [item for item in files if item.suffix.lower() in EXTENSIONS]
    if not files:
        print("No JPEG or PNG images found.")
        return 0

    try:
        image, image_ops = pillow_image()
    except (ImportError, OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        return 1

    failures = 0
    for file in files:
        result = optimize(file, image, image_ops)
        print(result)
        failures += result.startswith("Failed ")
    print(f"Done. Processed {len(files)} image(s); failures: {failures}.")
    return int(failures > 0)


if __name__ == "__main__":
    raise SystemExit(main())
