#!/data/data/com.termux/files/usr/bin/bash
# setup-ssh-agent-service.sh
# Idempotent one-shot setup: run ssh-agent as a runit service in Termux.
# Safe to re-run. The only manual step required is restarting Termux after
# termux-services is first installed (runit only starts at shell launch).

set -u

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
SERVICE_DIR="$PREFIX/etc/sv/ssh-agent"
SOCKET="$PREFIX/var/run/ssh-agent.socket"
SVDIR="$PREFIX/var/service"

step() { printf '\n\033[1;36m[%s]\033[0m %s\n' "$1" "$2"; }
ok()   { printf '  \033[1;32mok\033[0m - %s\n' "$1"; }
info() { printf '  \033[1;33mnote\033[0m - %s\n' "$1"; }

# --- 1. Ensure openssh (provides ssh-agent) is installed ---
step "1/5" "Checking for ssh-agent (openssh)..."
if ! command -v ssh-agent >/dev/null 2>&1; then
  info "openssh not found, installing..."
  pkg install -y openssh || { echo "ERROR: failed to install openssh"; exit 1; }
fi
ok "ssh-agent available at $(command -v ssh-agent)"

# --- 2. Ensure termux-services (runit) is installed ---
step "2/5" "Checking for termux-services (runit)..."
NEED_RESTART=0
if ! command -v sv >/dev/null 2>&1; then
  info "termux-services not found, installing..."
  pkg install -y termux-services || { echo "ERROR: failed to install termux-services"; exit 1; }
  NEED_RESTART=1
fi
ok "runit tools available"

# --- 3. Create / refresh the ssh-agent service definition ---
step "3/5" "Writing ssh-agent service definition ($SERVICE_DIR/run)..."
mkdir -p "$SERVICE_DIR"
cat > "$SERVICE_DIR/run" <<'RUNEOF'
#!/data/data/com.termux/files/usr/bin/sh
mkdir -p /data/data/com.termux/files/usr/var/run
exec ssh-agent -D -a /data/data/com.termux/files/usr/var/run/ssh-agent.socket
RUNEOF
chmod +x "$SERVICE_DIR/run"
ok "service definition written (foreground ssh-agent, socket at $SOCKET)"

# --- 4. Enable the service (create symlink = what sv-enable does, idempotent) ---
step "4/5" "Enabling service (symlink into $SVDIR)..."
mkdir -p "$SVDIR"
ln -sf "$SERVICE_DIR" "$SVDIR/ssh-agent"
ok "service enabled; will auto-start on every Termux launch"

# Try to start it now, if the supervisor is actually running in this session
if pgrep -x runsvdir >/dev/null 2>&1; then
  sv up ssh-agent 2>/dev/null || true
  sleep 1
  if sv status ssh-agent 2>/dev/null | grep -q '^run:'; then
    ok "ssh-agent service is running now"
  else
    info "service registered but not yet up; it will start after Termux restart"
    NEED_RESTART=1
  fi
else
  info "runit supervisor (runsvdir) not active in THIS shell session"
  NEED_RESTART=1
fi

# --- 5. Point shell profiles at the agent socket ---
step "5/5" "Adding SSH_AUTH_SOCK to shell profiles..."
for rc in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile"; do
  [ -f "$rc" ] || continue
  if grep -q 'SSH_AUTH_SOCK.*ssh-agent\.socket' "$rc"; then
    ok "already present in $rc"
  else
    printf '\n# ssh-agent runit service socket\nexport SSH_AUTH_SOCK=%s\n' "$SOCKET" >> "$rc"
    ok "added to $rc"
  fi
done

# --- Final instructions ---
printf '\n\033[1;32m=== Setup complete ===\033[0m\n'
if [ "$NEED_RESTART" -eq 1 ]; then
  printf '\n  \033[1;33mACTION REQUIRED:\033[0m Fully close Termux (swipe it away from recents),\n  then reopen it. The ssh-agent service will start automatically.\n\n'
fi
cat <<EOF
  After restarting (or in a new shell), run:

    ssh-add                 # load your key once (enter passphrase if any)
    ssh-add -l              # confirm key is listed
    ssh -T git@github.com   # test auth to your git host (or gitlab.com / bitbucket.org)

  If you have no SSH key yet, create one first:
    ssh-keygen -t ed25519 -C "your_email@example.com"
  ...then paste ~/.ssh/id_ed25519.pub into your host's SSH keys settings.
EOF
