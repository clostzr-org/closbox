home  = '/data/data/com.termux/files/home'
hbak  = home + '/bak'
hbin  = home + '/bin'
verbose = False

import osl; osl.osl(spath)
for message in osl.info:
    print(f'{{message}}')

args  = sys.argv[1:]
jargs = ' '.join(args).strip()

import inspect
def usg():
    usg = inspect.cleandoc(f\'\'\'
    alias: {{fgr}} {{frs}}
 function: {{fyl}} {{frs}}
    usage: {{frs}} {{sbn}} [argument]
    \'\'\')
    print(f'{{usg}}')
 
#insert_your_codes_here

if  __name__ == '__main__':
    try:
      if  sys.argv[1] == '-h':
          usg()
