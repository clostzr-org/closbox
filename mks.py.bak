#!/data/data/com.termux/files/usr/bin/python
import time
start_time = time.time()
from ansicolors import *

import os, sys

if  os.path.islink(sys.argv[0]):
    spath = os.readlink(sys.argv[0])
else:
    spath = os.path.abspath(sys.argv[0])
   
sdn   = os.path.dirname(spath)
sbn   = os.path.basename(spath)
sne   = os.path.splitext(sbn)[0]
sdbne = f'{sdn}/{sne}'
home  = '/data/data/com.termux/files/home'
hbak  = home + '/bak'
hbin  = home + '/bin'
hsym  = home + '/symlink'

if  not hbin in sys.path:
    sys.path.append(hbin)
   
import osl; osl.osl(spath)
for i in osl.info:
    print(f'{i}')

args  = sys.argv[1:]
jargs = ' '.join(args).strip()

import inspect
def usg():
    usg = inspect.cleandoc(f'''
    alias: {fgr} make-script{frs}
 function: {fyl} make a script with some environment preset in it{frs}
    usage: {frs} {sbn} [-py|-sh] [filename]{frs}
    ''')
    print(f'{usg}')
    sys.exit()

