#!/usr/bin/env python3
import subprocess, sys, os, tempfile

def get_deps():
    try:
        from pyzbar.pyzbar import decode
        from PIL import Image
        return decode, Image
    except ImportError:
        print("Installing dependencies...")
        subprocess.run(
            ["pkg", "install", "-y", "zbar"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        subprocess.run(
            [sys.executable, "-m", "pip", "install", "-q", "--force-reinstall", "pyzbar", "Pillow"]
        )
        from pyzbar.pyzbar import decode
        from PIL import Image
        return decode, Image

decode, Image = get_deps()

def scan():
    tmp = tempfile.mktemp(suffix=".jpg")
    subprocess.run(["termux-camera-photo", "-c", "0", tmp], check=True)

    found = False
    for obj in decode(Image.open(tmp)):
        print(f"[{obj.type}] {obj.data.decode('utf-8')}")
        found = True

    if not found:
        print("No codes found.")

    os.remove(tmp)

if __name__ == "__main__":
    scan()
